# Copy to .env (git-ignored) and fill in. With no key the pipeline runs deterministically.
# Keep comments on their own lines: values are read verbatim up to the end of the line.
# Provider: deepseek or anthropic (auto-detected from whichever key is set when left empty).
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# ANTHROPIC_API_KEY=
# AUDIT_MODEL=claude-opus-5-5
# AUDIT_EFFORT=medium
# Parallel model calls: how many in flight, and the most call starts per second (0 = no limit)
# LLM_MAX_CONCURRENCY=8
# LLM_CALLS_PER_SECOND=4
